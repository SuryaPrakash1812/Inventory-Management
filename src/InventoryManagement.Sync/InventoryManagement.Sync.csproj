<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InventoryManagement.Sync</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References the SQLite Infrastructure project (not Postgres) - the
      Sync Engine runs INSIDE the WPF process, reading the local Outbox and
      calling out to the API over HTTP. It never talks to PostgreSQL
      directly (Decision: WPF must not depend on PostgreSQL) - Contracts is
      what it uses to shape what it sends.
    -->
    <ProjectReference Include="..\InventoryManagement.Domain\InventoryManagement.Domain.csproj" />
    <ProjectReference Include="..\InventoryManagement.Contracts\InventoryManagement.Contracts.csproj" />
    <ProjectReference Include="..\InventoryManagement.Infrastructure\InventoryManagement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
