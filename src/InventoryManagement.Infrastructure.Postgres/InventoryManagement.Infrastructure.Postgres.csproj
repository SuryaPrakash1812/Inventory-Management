<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InventoryManagement.Infrastructure.Postgres</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Domain only - NOT Application, NOT the SQLite Infrastructure project.
      This project's job is "PostgreSQL persistence for the same Domain
      entities", not "reuse SQLite's EF Core configurations" (those were
      tuned around SQLite-specific limitations that don't apply here - see
      each configuration class's remarks). It also does not reference
      InventoryManagement.Infrastructure, and nothing in that project
      references this one - they are siblings, both implementing
      persistence for the same Domain, for different databases.
    -->
    <ProjectReference Include="..\InventoryManagement.Domain\InventoryManagement.Domain.csproj" />
  </ItemGroup>

</Project>
