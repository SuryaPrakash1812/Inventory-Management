<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InventoryManagement.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
