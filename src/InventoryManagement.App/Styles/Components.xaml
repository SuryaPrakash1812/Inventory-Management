<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
                    xmlns:converters="clr-namespace:InventoryManagement.App.Converters">

    <!-- Templates for Controls/PageComponents.cs, plus the app-wide table look. -->

    <converters:InitialsConverter x:Key="Initials" />

    <!-- ===== Page header ===== -->
    <Style TargetType="controls:PageHeader">
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PageHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="14" Margin="0,4,0,0" Foreground="{StaticResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Stat card ===== -->
    <Style TargetType="controls:StatCard">
        <Setter Property="Accent" Value="{StaticResource KpiBlueBrush}" />
        <Setter Property="AccentSoft" Value="{StaticResource KpiBlueSoftBrush}" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatCard">
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="12" Background="{TemplateBinding AccentSoft}" VerticalAlignment="Top">
                                <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="24" Foreground="{TemplateBinding Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <ContentPresenter Content="{TemplateBinding Value}" VerticalAlignment="Center"
                                                      TextElement.FontSize="26" TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <Border x:Name="BadgeChrome" Margin="10,0,0,0" CornerRadius="8" Padding="7,1" VerticalAlignment="Center"
                                            Background="{TemplateBinding AccentSoft}">
                                        <TextBlock Text="{TemplateBinding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Accent}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Caption}" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="BadgeChrome" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeChrome" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Search field ===== -->
    <Style TargetType="controls:SearchField">
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SearchField">
                    <Border x:Name="Chrome" CornerRadius="10" Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <Grid Margin="14,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24" FontSize="19" Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{TemplateBinding Placeholder}" FontSize="14" Foreground="{StaticResource AppTextMutedBrush}"
                                       Visibility="{Binding Text, ElementName=PART_TextBox, Converter={StaticResource EmptyStringToVisibility}}" />
                            <TextBox x:Name="PART_TextBox" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource BareTextBox}"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square bordered icon button (pager arrows, sort toggle, back button chrome) -->
    <Style x:Key="OutlineIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" CornerRadius="8" Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- White bordered text button with an optional leading icon ("Back to Products", "Export") -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8" Background="{StaticResource AppSurfaceBrush}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Pager ===== -->
    <Style TargetType="controls:Pager">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Pager">
                    <Grid Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Summary}" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                            <Button Style="{StaticResource OutlineIconButton}" Command="{TemplateBinding PreviousCommand}" ToolTip="Previous page">
                                <ui:SymbolIcon Symbol="ChevronLeft20" FontSize="16" />
                            </Button>
                            <Border MinWidth="40" Height="40" CornerRadius="8" Margin="12,0" Padding="10,0" Background="{StaticResource AppPrimaryBrush}">
                                <TextBlock Text="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" FontSize="14"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ToolTip="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}, StringFormat='of {0} pages'}" />
                            </Border>
                            <Button Style="{StaticResource OutlineIconButton}" Command="{TemplateBinding NextCommand}" ToolTip="Next page">
                                <ui:SymbolIcon Symbol="ChevronRight20" FontSize="16" />
                            </Button>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                  ItemsSource="{x:Static controls:Pager.PageSizeOptions}"
                                  SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0} per page'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Form section ===== -->
    <Style TargetType="controls:FormSection">
        <Setter Property="Accent" Value="{StaticResource KpiBlueBrush}" />
        <Setter Property="AccentSoft" Value="{StaticResource KpiBlueSoftBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FormSection">
                    <StackPanel>
                        <Border Background="{StaticResource AppTableHeaderBrush}" CornerRadius="10" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{TemplateBinding AccentSoft}">
                                    <ui:SymbolIcon Symbol="{TemplateBinding Icon}" FontSize="21" Foreground="{TemplateBinding Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ContentPresenter Margin="14,18,14,6" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Form field ===== -->
    <Style TargetType="controls:FormField">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FormField">
                    <StackPanel>
                        <TextBlock FontSize="13.5" FontWeight="Medium" Margin="0,0,0,6" Foreground="{StaticResource AppTextPrimaryBrush}">
                            <Run Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run x:Name="RequiredMark" Text=" *" Foreground="{StaticResource AppDangerBrush}" /><Run x:Name="OptionalMark" Text=" (Optional)" FontWeight="Normal" Foreground="{StaticResource AppTextMutedBrush}" />
                        </TextBlock>
                        <ContentPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRequired" Value="False">
                            <Setter TargetName="RequiredMark" Property="Text" Value="" />
                        </Trigger>
                        <Trigger Property="IsOptional" Value="False">
                            <Setter TargetName="OptionalMark" Property="Text" Value="" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Row "⋯" actions button ===== -->
    <Style TargetType="controls:RowActionsButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Actions" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RowActionsButton">
                    <Border x:Name="Chrome" CornerRadius="8" Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="{StaticResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AppHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Labelled filter row items ("Category  [combo]") -->
    <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Active / Inactive pill for any row with an IsActive property: ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivePill}" -->
    <DataTemplate x:Key="ActivePill">
        <Border x:Name="Pill" Style="{StaticResource StatusPill}" Background="#DCFCE7">
            <TextBlock x:Name="Label" Text="Active" FontSize="12.5" Foreground="#15803D" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter TargetName="Pill" Property="Background" Value="#F1F5F9" />
                <Setter TargetName="Label" Property="Text" Value="Inactive" />
                <Setter TargetName="Label" Property="Foreground" Value="#475569" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Name cell with a round initial avatar (suppliers, customers, users): binds to Name -->
    <DataTemplate x:Key="NameWithAvatar">
        <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource KpiBlueSoftBrush}">
                <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Audit history entries (supplier / customer History view) -->
    <DataTemplate x:Key="HistoryEntry">
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource KpiBlueSoftBrush}" VerticalAlignment="Top">
                <ui:SymbolIcon Symbol="History24" FontSize="17" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Action}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="{Binding OccurredAtUtc, StringFormat='{}{0:g}'}" FontSize="12.5" Margin="10,1,0,0"
                               Foreground="{StaticResource AppTextMutedBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Details}" FontSize="13.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Inline success / error messages on a page -->
    <Style x:Key="SuccessMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#15803D" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ErrorMessage" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#B91C1C" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Tables: applied to every DataGrid in the app ===== -->
    <Style x:Key="AppColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="16,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="54" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F8FAFC" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppPrimarySoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource AppDataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource AppDataGridRow}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
</ResourceDictionary>
