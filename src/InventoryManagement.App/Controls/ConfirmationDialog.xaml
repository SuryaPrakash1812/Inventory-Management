<UserControl x:Class="InventoryManagement.App.Controls.ConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">

    <!-- DataContext is a ConfirmationDialogViewModel. Goes last in the page's root Grid, so it covers the page. -->
    <Grid Background="#660F172A">
        <Border Style="{StaticResource Card}" Width="600" Padding="26,24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <Button Grid.Column="1" Style="{StaticResource OutlineIconButton}" Width="34" Height="34" Margin="16,0,0,0" VerticalAlignment="Top"
                            ToolTip="Close" Command="{Binding DismissCommand}">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource AppTextSecondaryBrush}" />

                <!-- What happens to stock, per product -->
                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,16,0,0"
                        Visibility="{Binding HasStockLines, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Product" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="In stock" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Change" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="After" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Right" />
                        </Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding StockLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Padding="14,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProductName}" Style="{StaticResource TableCellText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CurrentStock, StringFormat=0.##}" Style="{StaticResource TableCellText}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Change, StringFormat='+0.##;-0.##;0'}" Style="{StaticResource TableCellText}" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="After" Grid.Column="3" Text="{Binding StockAfter, StringFormat=0.##}" Style="{StaticResource TableCellText}"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPossible}" Value="False">
                                                <Setter TargetName="After" Property="Foreground" Value="{StaticResource AppDangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border CornerRadius="10" Padding="14,10" Margin="0,14,0,0" Background="#FEF3C7"
                        Visibility="{Binding Warning, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding Warning}" FontSize="13.5" TextWrapping="Wrap" Foreground="#B45309" />
                </Border>

                <controls:FormField Label="Reason" IsOptional="True" Margin="0,16,0,0"
                                    Visibility="{Binding AsksReason, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Why is this being cancelled? Saved in the notes." />
                </controls:FormField>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource OutlineButton}" Content="{Binding DismissText}" Command="{Binding DismissCommand}" MinWidth="96" />
                    <Grid Margin="12,0,0,0" Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Appearance="Danger" Content="{Binding ConfirmText}" Height="40" Padding="18,0" Command="{Binding AcceptCommand}"
                                   Visibility="{Binding IsDanger, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Appearance="Primary" Content="{Binding ConfirmText}" Height="40" Padding="18,0" Command="{Binding AcceptCommand}"
                                   Visibility="{Binding IsDanger, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
