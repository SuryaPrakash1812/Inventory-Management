<Page x:Class="InventoryManagement.App.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Products">
    <Grid>

        <!-- ================= LIST VIEW ================= -->
        <ScrollViewer x:Name="ListScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <controls:PageHeader Title="Products" Subtitle="Manage your product catalog, pricing and stock levels.">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New Product" Height="40" Padding="16,0"
                                   Command="{Binding StartCreateCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource OutlineButton}" Click="OnExportClick" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="17" Margin="0,0,8,0" />
                                <TextBlock Text="Export" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Click="OnImportClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowImport24" FontSize="17" Margin="0,0,8,0" />
                                <TextBlock Text="Import" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageHeader>

                <!-- Summary cards -->
                <UniformGrid Columns="4" Margin="0,0,-16,20">
                    <controls:StatCard Title="Total Products" Value="{Binding ActiveProductCount}" Caption="Active products in catalog"
                                       Icon="Cube24" Accent="{StaticResource KpiBlueBrush}" AccentSoft="{StaticResource KpiBlueSoftBrush}" />
                    <controls:StatCard Title="In Stock" Value="{Binding InStockCount}" Badge="{Binding InStockPercent}" Caption="Products available"
                                       Icon="BoxCheckmark24" Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}" />
                    <controls:StatCard Title="Low Stock" Value="{Binding LowStockCount}" Badge="{Binding LowStockPercent}" Caption="Need attention"
                                       Icon="Warning24" Accent="{StaticResource KpiOrangeBrush}" AccentSoft="{StaticResource KpiOrangeSoftBrush}" />
                    <controls:StatCard Title="Out of Stock" Value="{Binding OutOfStockCount}" Badge="{Binding OutOfStockPercent}" Caption="Currently out of stock"
                                       Icon="BoxDismiss24" Accent="#DC2626" AccentSoft="#FEE2E2" />
                </UniformGrid>

                <!-- Filters + table -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="20,20,20,16">
                            <controls:SearchField Text="{Binding SearchTerm}" Placeholder="Search by SKU, barcode, or name..."
                                                  SubmitCommand="{Binding SearchCommand}" Margin="0,0,0,14" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Category" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding CategoryFilterOptions}"
                                          SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Name" />
                                <TextBlock Text="Status" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding ActiveFilterOptions}"
                                          SelectedItem="{Binding SelectedActiveFilter}" />
                                <TextBlock Text="Sort by" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding SortColumns}"
                                          SelectedItem="{Binding SelectedSortColumn}" Margin="0,0,10,0" />
                                <ToggleButton Style="{StaticResource OutlineIconButton}" IsChecked="{Binding SortDescending}"
                                              ToolTip="Toggle ascending / descending" Margin="0,0,20,0">
                                    <ui:SymbolIcon Symbol="ArrowSort24" FontSize="18" />
                                </ToggleButton>
                                <Button Style="{StaticResource OutlineButton}" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" MinHeight="120" controls:RowDoubleClick.Command="{Binding StartEditCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTemplateColumn Header="Category" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{StaticResource KpiBlueSoftBrush}">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12.5" Foreground="{StaticResource KpiBlueBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Brand" Binding="{Binding Brand, TargetNullValue='-'}" Width="*" />
                                <DataGridTextColumn Header="Sell Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="110" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat=0.##}" Width="90" />
                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Tag holds the status label; the pill colours derive from it -->
                                            <Border Style="{StaticResource StatusPill}"
                                                    Tag="{Binding Converter={StaticResource ProductStockStatus}}"
                                                    Background="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" FontSize="12.5"
                                                           Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:RowActionsButton Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <controls:RowActionsButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.StartEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Deactivate" Command="{Binding PlacementTarget.Tag.DeactivateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Prohibited24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </controls:RowActionsButton.ContextMenu>
                                            </controls:RowActionsButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0">
                            <controls:Pager ItemName="products" PageNumber="{Binding PageNumber}" TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}" PageSize="{Binding PageSize}"
                                            PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= EDIT VIEW ================= -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Products" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="Cube24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Product Details" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Add or edit product information, pricing and stock details." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <controls:FormSection Title="Basic Information" Subtitle="Core product details" Icon="Cube24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:FormField Label="SKU" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormSku, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewProduct}"
                                                PlaceholderText="e.g. RS-001" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Barcode" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Grid.Row="1" Label="Product Name" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Grid.Row="1" Grid.Column="2" Label="Brand" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormBrand, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Grid.Row="2" Grid.ColumnSpan="3" Label="Description">
                                    <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter product description..."
                                                AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalContentAlignment="Top" />
                                </controls:FormField>
                            </Grid>
                        </controls:FormSection>

                        <controls:FormSection Title="Classification" Subtitle="Organize your product with category and unit" Icon="Tag24"
                                              Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:FormField Label="Category" IsRequired="True">
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FormCategory}" DisplayMemberPath="Name" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Unit" IsRequired="True">
                                    <ComboBox IsEditable="True" ItemsSource="{Binding UnitOptions}" Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                            </Grid>
                        </controls:FormSection>

                        <controls:FormSection Title="Pricing" Subtitle="Set purchase price, selling price and tax details" Icon="Money24"
                                              Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:FormField Label="Purchase Price" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormPurchasePrice}" GotFocus="OnNumericFieldGotFocus" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Selling Price" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormSellingPrice}" GotFocus="OnNumericFieldGotFocus" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="4" Label="Tax %" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormTaxPercentage}" GotFocus="OnNumericFieldGotFocus" />
                                </controls:FormField>
                            </Grid>
                        </controls:FormSection>

                        <controls:FormSection Title="Stock Information" Subtitle="Set stock levels and alerts" Icon="Database24"
                                              Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:FormField Label="Minimum Stock" IsOptional="True">
                                        <ui:TextBox Text="{Binding FormMinimumStock}" GotFocus="OnNumericFieldGotFocus" />
                                    </controls:FormField>
                                    <controls:FormField Grid.Column="2" Label="Initial Stock" IsOptional="True"
                                                        Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibility}}">
                                        <ui:TextBox Text="{Binding FormInitialStock}" GotFocus="OnNumericFieldGotFocus" />
                                    </controls:FormField>
                                    <controls:FormField Grid.Column="2" Label="Current Stock"
                                                        Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}">
                                        <ui:TextBox Text="{Binding FormCurrentStock, Mode=OneWay, StringFormat=N2}" IsEnabled="False" />
                                    </controls:FormField>
                                </Grid>
                                <TextBlock Text="Stock changes through purchases, sales and stock adjustments - it is not edited here."
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,-6,0,12"
                                           Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}" />
                                <CheckBox Content="Active (shown in lists, searches and new documents)" IsChecked="{Binding FormIsActive}" Margin="0,0,0,8"
                                          Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </controls:FormSection>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="14,4,14,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource OutlineButton}" Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,12,0" MinWidth="96" />
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save Product" Height="40" Padding="18,0"
                                           Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
