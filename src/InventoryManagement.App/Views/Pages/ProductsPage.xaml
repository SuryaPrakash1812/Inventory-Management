<Page x:Class="InventoryManagement.App.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Products">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search + primary actions -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox x:Name="SearchBox"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search by SKU, barcode, or name"
                        Width="300"
                        Margin="0,0,8,0">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Content="Search" Command="{Binding SearchCommand}" Margin="0,0,16,0" />
            <ui:Button Content="New Product" Command="{Binding StartCreateCommand}" Appearance="Primary" Margin="0,0,8,0" />
            <ui:Button Content="Export" Click="OnExportClick" Margin="0,0,8,0" />
            <ui:Button Content="Import" Click="OnImportClick" />
        </StackPanel>

        <!-- Filters + sort -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategoryFilter}"
                      DisplayMemberPath="Name"
                      MinWidth="160"
                      Margin="0,0,16,0" />

            <ui:TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding ActiveFilterOptions}"
                      SelectedItem="{Binding SelectedActiveFilter}"
                      MinWidth="120"
                      Margin="0,0,16,0" />

            <ui:TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding SortColumns}"
                      SelectedItem="{Binding SelectedSortColumn}"
                      MinWidth="140"
                      Margin="0,0,8,0" />
            <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Grid + edit panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Products}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120" />
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="100" />
                    <DataGridTextColumn Header="Sell Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="80" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat=N0}" Width="70" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55" />
                    <DataGridTemplateColumn Header="" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Edit"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Deactivate"
                                               Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ui:Card>
                    <StackPanel>
                        <ui:TextBlock Text="Product Details" FontTypography="BodyStrong" Margin="0,0,0,12" />

                        <ui:TextBox Text="{Binding FormSku, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="SKU"
                                    IsEnabled="{Binding IsNewProduct}"
                                    Margin="0,0,0,8" />
                        <ui:TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Barcode (optional)"
                                    Margin="0,0,0,8" />
                        <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Name"
                                    Margin="0,0,0,8" />
                        <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Description (optional)"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="60"
                                    Margin="0,0,0,8" />
                        <ui:TextBox Text="{Binding FormBrand, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Brand (optional)"
                                    Margin="0,0,0,8" />

                        <ui:TextBlock Text="Category" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding FormCategory}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8" />

                        <ui:TextBox Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Unit (e.g. pcs, kg)"
                                    Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding FormPurchasePrice, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Purchase price" />
                            <ui:TextBox Grid.Column="2" Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Selling price" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" Text="{Binding FormTaxPercentage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tax %" />
                            <ui:TextBox Grid.Column="2" Text="{Binding FormMinimumStock, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Minimum stock" />
                        </Grid>

                        <ui:TextBox Text="{Binding FormInitialStock, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Initial stock"
                                    Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,0,0,8" />

                        <Grid Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}"
                              Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock Text="Current stock" FontTypography="Caption" Opacity="0.6" />
                                <ui:TextBlock Text="{Binding FormCurrentStock, StringFormat=N2}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="Stock changes through purchases, sales, and adjustments in later stages - not editable here."
                                              FontTypography="Caption"
                                              Opacity="0.5"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Active"
                                  IsChecked="{Binding FormIsActive}"
                                  Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}"
                                  Margin="0,0,0,12" />

                        <ui:TextBlock Text="{Binding ErrorMessage}"
                                      Foreground="IndianRed"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0" />
                            <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </ScrollViewer>
        </Grid>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
            <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Page" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="total)" />
            </ui:TextBlock>
            <ui:Button Content="Next" Command="{Binding NextPageCommand}" Margin="0,0,16,0" />
            <ui:TextBlock Text="{Binding StatusMessage}" Foreground="Green" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
