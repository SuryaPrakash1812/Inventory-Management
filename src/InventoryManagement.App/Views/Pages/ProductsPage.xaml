<Page x:Class="InventoryManagement.App.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Products">
    <Grid Margin="20">

        <!-- LIST VIEW: search, filters, grid, pagination. Hidden entirely
             while editing, rather than squeezing an edit panel in beside it -
             a form needs room to breathe, and a narrow sidebar fighting the
             grid for space reads as a bolted-on popup, not a real page. -->
        <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="New Product" Command="{Binding StartCreateCommand}" Appearance="Primary" Margin="0,0,8,8" />
                <ui:Button Content="Export" Click="OnExportClick" Margin="0,0,8,8" />
                <ui:Button Content="Import" Click="OnImportClick" Margin="0,0,0,8" />
            </WrapPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBox x:Name="SearchBox"
                            Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search by SKU, barcode, or name"
                            Width="260"
                            Margin="0,0,16,8">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          DisplayMemberPath="Name"
                          MinWidth="160"
                          Margin="0,0,16,8" />

                <ui:TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding ActiveFilterOptions}"
                          SelectedItem="{Binding SelectedActiveFilter}"
                          MinWidth="120"
                          Margin="0,0,16,8" />

                <ui:TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding SortColumns}"
                          SelectedItem="{Binding SelectedSortColumn}"
                          MinWidth="140"
                          Margin="0,0,8,8" />
                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,16,8" />

                <ui:Button Content="Search" Command="{Binding SearchCommand}" Appearance="Primary" Margin="0,0,8,8" />
                <ui:Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,16,8" />
                <ui:TextBlock Text="Filters apply when you click Search"
                              FontTypography="Caption"
                              Opacity="0.6"
                              VerticalAlignment="Center"
                              Margin="0,0,0,8" />
            </WrapPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Products}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" />
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120" />
                    <DataGridTextColumn Header="Sell Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat=N0}" Width="80" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    <DataGridTemplateColumn Header="" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Edit"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Deactivate"
                                               Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                    <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="total)" />
                </ui:TextBlock>
                <ui:Button Content="Next" Command="{Binding NextPageCommand}" Margin="0,0,16,0" />
                <ui:TextBlock Text="{Binding StatusMessage}" Foreground="Green" VerticalAlignment="Center" />
            </WrapPanel>
        </Grid>

        <!-- EDIT VIEW: full width, its own dedicated screen. The outer Grid
             has an explicit (if transparent) Background so it is
             hit-testable across its ENTIRE width - without this, mouse-wheel
             scrolling only worked directly over the form itself or the
             scrollbar track, since the empty space beside a narrow
             left-aligned StackPanel isn't part of any hit-testable element
             by default. -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
                    <ui:Button Content="&#x2190; Back to Products"
                               Command="{Binding CancelEditCommand}"
                               Appearance="Transparent"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12" />

                    <ui:Card Padding="28">
                        <StackPanel>
                            <ui:TextBlock Text="Product Details" FontTypography="TitleLarge" Margin="0,0,0,24" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="SKU (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormSku, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsNewProduct}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Barcode (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Name (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Brand (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormBrand, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <ui:TextBlock Text="Description (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="80"
                                        Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Category (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding FormCategory}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Unit (required, e.g. pcs, kg)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormUnit, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Purchase price (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormPurchasePrice}" GotFocus="OnNumericFieldGotFocus" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Selling price (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormSellingPrice}" GotFocus="OnNumericFieldGotFocus" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <ui:TextBlock Text="Tax % (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormTaxPercentage}" GotFocus="OnNumericFieldGotFocus" Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Minimum stock (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormMinimumStock}" GotFocus="OnNumericFieldGotFocus" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVisibility}}">
                                    <ui:TextBlock Text="Initial stock (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormInitialStock}" GotFocus="OnNumericFieldGotFocus" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}">
                                    <ui:TextBlock Text="Current stock" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBlock Text="{Binding FormCurrentStock, StringFormat=N2}" FontTypography="BodyStrong" Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <ui:TextBlock Text="Stock changes through purchases, sales, and adjustments in later stages - not editable here."
                                          Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}"
                                          FontTypography="Caption"
                                          Opacity="0.5"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,12" />

                            <CheckBox Content="Active"
                                      IsChecked="{Binding FormIsActive}"
                                      Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVisibility}}"
                                      Margin="0,0,0,16" />

                            <ui:TextBlock Text="{Binding ErrorMessage}"
                                          Foreground="IndianRed"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
