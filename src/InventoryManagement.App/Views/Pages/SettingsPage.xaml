<Page x:Class="InventoryManagement.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" PanningMode="VerticalOnly">
        <StackPanel Margin="20,4,20,24">
            <controls:PageHeader Title="Settings" Subtitle="Your business details, backup preferences and license." />

            <Border Style="{StaticResource Card}" Padding="24,22">
                <StackPanel>
                    <controls:FormSection Title="Company" Subtitle="Shown at the top of exported reports" Icon="Building24">
                        <StackPanel>
                            <controls:FormField Label="Business Name" IsOptional="True">
                                <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                            <controls:FormField Label="Address" IsOptional="True">
                                <ui:TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </controls:FormField>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:FormField Label="Phone" IsOptional="True">
                                    <ui:TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Email" IsOptional="True">
                                    <ui:TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="4" Label="GSTIN / VAT Number" IsOptional="True">
                                    <ui:TextBox Text="{Binding CompanyTaxId, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                            </Grid>
                        </StackPanel>
                    </controls:FormSection>

                    <controls:FormSection Title="Backup" Subtitle="Where backups go and how often they are taken automatically" Icon="CloudArrowUp24"
                                          Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}">
                        <StackPanel>
                            <controls:FormField Label="Backup Folder" IsOptional="True">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default folder" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="Browse..." Command="{Binding BrowseBackupFolderCommand}" Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Use Default" Command="{Binding UseDefaultBackupFolderCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DefaultBackupFolder, StringFormat='Leave empty to use the default: {0}'}" Style="{StaticResource SecondaryText}"
                                               FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </controls:FormField>

                            <CheckBox Content="Take automatic backups" IsChecked="{Binding AutomaticBackupsEnabled}" Margin="0,0,0,14" />

                            <Grid IsEnabled="{Binding AutomaticBackupsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:FormField Label="Back Up Every (hours)">
                                    <ComboBox ItemsSource="{Binding AvailableIntervals}" SelectedItem="{Binding AutomaticIntervalHours}" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Automatic Backups to Keep">
                                    <ui:TextBox Text="{Binding RetentionCountText, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                            </Grid>
                            <TextBlock Text="Manual backups are never deleted automatically." Style="{StaticResource SecondaryText}" Margin="0,-6,0,8" />
                        </StackPanel>
                    </controls:FormSection>

                    <TextBlock Text="{Binding ConfirmationMessage}" Style="{StaticResource SuccessMessage}" Margin="14,4,14,0"
                               Visibility="{Binding ConfirmationMessage, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="14,4,14,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                    <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save Settings" Height="40" Padding="18,0"
                                   HorizontalAlignment="Right" Command="{Binding SaveCommand}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- License (read-only) -->
            <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,20,0,0">
                <controls:FormSection Title="License" Subtitle="This copy is licensed to one PC" Icon="Certificate24"
                                      Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Licensed to" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Grid.Column="1" Text="{Binding LicensedTo}" FontSize="14" FontWeight="Medium" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Text="Machine ID" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource BareTextBox}"
                                 FontFamily="Consolas" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Text="License ID" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,10" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LicenseId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource BareTextBox}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="3" Text="Issued" Style="{StaticResource SecondaryText}" FontSize="14" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseIssued}" FontSize="14" />
                    </Grid>
                </controls:FormSection>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
