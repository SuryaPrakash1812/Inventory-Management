<Page x:Class="InventoryManagement.App.Views.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Inventory">
    <Grid>

        <!-- ================= OVERVIEW ================= -->
        <ScrollViewer x:Name="OverviewScrollViewer"
                      Visibility="{Binding IsShowingOverview, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <controls:PageHeader Title="Inventory" Subtitle="Current stock levels, stock value and the movement history of every product." />

                <UniformGrid Columns="4" Margin="0,0,-16,20">
                    <controls:StatCard Title="Stock Value (Cost)" Caption="{Binding ValuationProductCount, StringFormat='{}{0} active products'}"
                                       Icon="Database24" Accent="{StaticResource KpiBlueBrush}" AccentSoft="{StaticResource KpiBlueSoftBrush}">
                        <controls:StatCard.Value>
                            <TextBlock Text="{Binding ValuationTotalCostValue, StringFormat=N2}" />
                        </controls:StatCard.Value>
                    </controls:StatCard>
                    <controls:StatCard Title="Stock Value (Retail)" Caption="At current selling prices"
                                       Icon="Money24" Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}">
                        <controls:StatCard.Value>
                            <TextBlock Text="{Binding ValuationTotalRetailValue, StringFormat=N2}" />
                        </controls:StatCard.Value>
                    </controls:StatCard>
                    <controls:StatCard Title="Low Stock" Value="{Binding LowStockCount}" Caption="At or below minimum stock"
                                       Icon="Warning24" Accent="{StaticResource KpiOrangeBrush}" AccentSoft="{StaticResource KpiOrangeSoftBrush}" />
                    <controls:StatCard Title="Out of Stock" Value="{Binding OutOfStockCount}" Caption="Nothing on hand"
                                       Icon="BoxDismiss24" Accent="#DC2626" AccentSoft="#FEE2E2" />
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="20,20,20,16">
                            <controls:SearchField Text="{Binding SearchTerm}" Placeholder="Search by SKU, barcode, or name..."
                                                  SubmitCommand="{Binding SearchCommand}" Margin="0,0,0,14" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Category" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Name" />
                                <TextBlock Text="Stock Status" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding StatusFilterOptions}"
                                          SelectedItem="{Binding SelectedStatusFilter}" />
                                <Button Style="{StaticResource OutlineButton}" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" MinHeight="120" controls:RowDoubleClick.Command="{Binding ViewHistoryCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="110" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding Product.Name}" Width="2*" />
                                <DataGridTemplateColumn Header="Category" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{StaticResource KpiBlueSoftBrush}">
                                                <TextBlock Text="{Binding Product.CategoryName}" FontSize="12.5" Foreground="{StaticResource KpiBlueBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Current Stock" Binding="{Binding Product.CurrentStock, StringFormat=0.##}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Minimum" Binding="{Binding Product.MinimumStock, StringFormat=0.##}" Width="*" />
                                <DataGridTextColumn Header="Stock Value" Binding="{Binding StockValueAtCost, StringFormat=N2}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding StockStatus, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding StockStatus}" FontSize="12.5"
                                                           Foreground="{Binding StockStatus, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:RowActionsButton Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <controls:RowActionsButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Stock history" Command="{Binding PlacementTarget.Tag.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="History24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </controls:RowActionsButton.ContextMenu>
                                            </controls:RowActionsButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0">
                            <controls:Pager ItemName="products" PageNumber="{Binding PageNumber}" TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}" PageSize="{Binding PageSize}"
                                            PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= STOCK HISTORY ================= -->
        <ScrollViewer x:Name="HistoryScrollViewer"
                      Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CloseHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Inventory" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,22,24,18">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="History24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryProductName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Every stock movement for this product, newest first." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding HistoryEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding OccurredAtUtc, StringFormat=g}" Width="1.3*" />
                                <DataGridTemplateColumn Header="Movement" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding MovementType, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding MovementType, Converter={StaticResource EnumDisplay}}" FontSize="12.5"
                                                           Foreground="{Binding MovementType, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Change" Binding="{Binding QuantityChange, StringFormat=+0.##;-0.##;0}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Balance After" Binding="{Binding QuantityBalanceAfter, StringFormat=0.##}" Width="*" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceType, Converter={StaticResource EnumDisplay}}" Width="*" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, TargetNullValue='-'}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Height="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
