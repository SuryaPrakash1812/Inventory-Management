<Page x:Class="InventoryManagement.App.Views.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Inventory">
    <Grid Margin="20">

        <!-- OVERVIEW -->
        <ScrollViewer x:Name="OverviewScrollViewer"
                      Visibility="{Binding IsShowingOverview, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Valuation summary -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                        <StackPanel>
                            <ui:TextBlock Text="Products" FontTypography="Caption" Opacity="0.6" />
                            <ui:TextBlock Text="{Binding ValuationProductCount}" FontTypography="TitleLarge" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                        <StackPanel>
                            <ui:TextBlock Text="Inventory Value (Cost)" FontTypography="Caption" Opacity="0.6" />
                            <ui:TextBlock Text="{Binding ValuationTotalCostValue, StringFormat=N2}" FontTypography="TitleLarge" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,12,8">
                        <StackPanel>
                            <ui:TextBlock Text="Inventory Value (Retail)" FontTypography="Caption" Opacity="0.6" />
                            <ui:TextBlock Text="{Binding ValuationTotalRetailValue, StringFormat=N2}" FontTypography="TitleLarge" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,0,8">
                        <StackPanel>
                            <ui:TextBlock Text="Low Stock Items" FontTypography="Caption" Opacity="0.6" />
                            <ui:TextBlock Text="{Binding LowStockCount}" FontTypography="TitleLarge" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Filters -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search by SKU, barcode, or name"
                                Width="240"
                                Margin="0,0,16,8">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>

                    <ui:TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryFilter}"
                              DisplayMemberPath="Name"
                              MinWidth="150"
                              Margin="0,0,16,8" />

                    <ui:TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              MinWidth="120"
                              Margin="0,0,16,8" />

                    <ui:Button Content="Search" Command="{Binding SearchCommand}" Appearance="Primary" Margin="0,0,8,8" />
                    <ui:Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" />
                </WrapPanel>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Products}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          MinHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="100" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Product.Name}" Width="200" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Product.CategoryName}" Width="140" />
                        <DataGridTextColumn Header="Current Stock" Binding="{Binding Product.CurrentStock, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Reorder Level" Binding="{Binding Product.MinimumStock, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Stock Value" Binding="{Binding StockValueAtCost, StringFormat=N2}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StockStatus}" Width="100" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="History"
                                               Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                    <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="Page" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                        <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="total)" />
                    </ui:TextBlock>
                    <ui:Button Content="Next" Command="{Binding NextPageCommand}" />
                </WrapPanel>
            </Grid>
        </ScrollViewer>

        <!-- HISTORY -->
        <ScrollViewer x:Name="HistoryScrollViewer"
                      Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <ui:Button Content="Back to overview" Command="{Binding CloseHistoryCommand}" Margin="0,0,16,0" />
                    <ui:TextBlock Text="{Binding HistoryProductName}" FontTypography="TitleLarge" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding HistoryEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          MinHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding OccurredAtUtc, StringFormat=g}" Width="150" />
                        <DataGridTextColumn Header="Movement Type" Binding="{Binding MovementType}" Width="150" />
                        <DataGridTextColumn Header="Quantity Change" Binding="{Binding QuantityChange, StringFormat=N2}" Width="130" />
                        <DataGridTextColumn Header="Balance After" Binding="{Binding QuantityBalanceAfter, StringFormat=N2}" Width="120" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceType}" Width="110" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
