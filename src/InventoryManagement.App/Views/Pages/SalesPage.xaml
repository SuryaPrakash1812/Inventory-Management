<Page x:Class="InventoryManagement.App.Views.Pages.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Sales">

    <Page.Resources>
        <!-- Inline number input used in the editable line-item columns -->
        <Style x:Key="LineInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditFields, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>
    </Page.Resources>

    <Grid>

        <!-- ================= LIST VIEW ================= -->
        <ScrollViewer x:Name="ListScrollViewer"
                      Visibility="{Binding IsShowingList, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <controls:PageHeader Title="Sales" Subtitle="Create sales, issue invoices and track what you have sold.">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New Sale" Height="40" Padding="16,0"
                               Command="{Binding StartCreateCommand}" />
                </controls:PageHeader>

                <UniformGrid Columns="4" Margin="0,0,-16,20">
                    <controls:StatCard Title="Total Sales" Value="{Binding AllSaleCount}" Caption="All sales documents"
                                       Icon="ReceiptMoney24" Accent="{StaticResource KpiBlueBrush}" AccentSoft="{StaticResource KpiBlueSoftBrush}" />
                    <controls:StatCard Title="Drafts" Value="{Binding DraftSaleCount}" Caption="Not yet invoiced"
                                       Icon="DocumentEdit24" Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}" />
                    <controls:StatCard Title="Invoiced" Value="{Binding InvoicedSaleCount}" Caption="Invoiced and stock issued"
                                       Icon="CheckmarkCircle24" Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}" />
                    <controls:StatCard Title="Revenue" Caption="Total of invoiced sales"
                                       Icon="Money24" Accent="{StaticResource KpiOrangeBrush}" AccentSoft="{StaticResource KpiOrangeSoftBrush}">
                        <controls:StatCard.Value>
                            <TextBlock Text="{Binding InvoicedSaleValue, StringFormat=N2}" />
                        </controls:StatCard.Value>
                    </controls:StatCard>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="20,20,20,16">
                            <controls:SearchField Text="{Binding SearchTerm}" Placeholder="Search by sale # or invoice #..."
                                                  SubmitCommand="{Binding SearchCommand}" Margin="0,0,0,14" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Customer" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding CustomerFilterOptions}"
                                          SelectedItem="{Binding SelectedCustomerFilter}" DisplayMemberPath="Name" />
                                <TextBlock Text="Status" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding StatusFilterOptions}"
                                          SelectedItem="{Binding SelectedStatusFilter}" MinWidth="140" />
                                <Button Style="{StaticResource OutlineButton}" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" MinHeight="120" controls:RowDoubleClick.Command="{Binding StartViewCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}" Width="1.3*" FontWeight="Medium" />
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber, TargetNullValue='-'}" Width="1.3*" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.6*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=MMM d\, yyyy}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*" FontWeight="SemiBold" />
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:RowActionsButton Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <controls:RowActionsButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.StartViewCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </controls:RowActionsButton.ContextMenu>
                                            </controls:RowActionsButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0">
                            <controls:Pager ItemName="sales" PageNumber="{Binding PageNumber}" TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}" PageSize="{Binding PageSize}"
                                            PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= DETAIL / EDIT VIEW ================= -->
        <ScrollViewer x:Name="DetailScrollViewer"
                      Visibility="{Binding IsViewingDetail, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Sales" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Padding="24,22">
                    <StackPanel>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SaleNumberDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <Border Style="{StaticResource StatusPill}" Margin="14,0,0,0" Background="{Binding CurrentStatus, Converter={StaticResource StatusPillBrush}}">
                                        <TextBlock Text="{Binding CurrentStatus}" FontSize="13"
                                                   Foreground="{Binding CurrentStatus, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                    <TextBlock Text="{Binding InvoiceNumberDisplay}" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Customer, items and totals. Invoicing issues the items from stock." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Grid>

                        <controls:FormSection Title="Sale Information" Subtitle="Customer, date and notes" Icon="DocumentText24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <controls:FormField Label="Customer" IsRequired="True">
                                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding FormCustomer}" DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEditFields}" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="2" Label="Sale Date" IsRequired="True">
                                    <DatePicker SelectedDate="{Binding FormSaleDate}" IsEnabled="{Binding CanEditFields}" />
                                </controls:FormField>
                                <controls:FormField Grid.Column="4" Label="Notes" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFields}" />
                                </controls:FormField>
                            </Grid>
                        </controls:FormSection>

                        <controls:FormSection Title="Items" Subtitle="Scan or type a SKU, barcode or name, then press Enter to add it" Icon="BoxMultiple24"
                                              Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                            Visibility="{Binding CanEditFields, Converter={StaticResource BoolToVisibility}}">
                                    <controls:SearchField Text="{Binding ProductSearchText}" Placeholder="Scan or type SKU, barcode, or name"
                                                          SubmitCommand="{Binding AddLineItemCommand}" SubmitOnTyping="False" Width="460" />
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Add" Height="44" Padding="16,0" Margin="10,0,0,0"
                                               Command="{Binding AddLineItemCommand}" />
                                </StackPanel>

                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              CanUserSortColumns="False" MinHeight="90">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTemplateColumn Header="Quantity" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource LineInput}" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Unit Price" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource LineInput}" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Discount" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource LineInput}" Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="*" FontWeight="SemiBold" />
                                            <DataGridTemplateColumn Header="" Width="64">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource OutlineIconButton}" Width="34" Height="34" ToolTip="Remove item"
                                                                Visibility="{Binding DataContext.CanEditFields, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"
                                                                Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{StaticResource AppDangerBrush}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Totals -->
                                <Border HorizontalAlignment="Right" Width="320" Margin="0,16,0,8" Padding="18,14" CornerRadius="10"
                                        Background="{StaticResource AppTableHeaderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Subtotal" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormSubtotal, StringFormat=N2}" FontSize="14" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Text="Discount" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,10" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormDiscountTotal, StringFormat=- {0:N2}}" FontSize="14" Margin="0,0,0,10" />
                                        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                            <Grid>
                                                <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding FormTotal, StringFormat=N2}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource AppTextPrimaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </controls:FormSection>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="14,4,14,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessMessage}" Margin="14,4,14,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding DeleteDraftCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,12,0"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="17" Margin="0,0,8,0" Foreground="{StaticResource AppDangerBrush}" />
                                            <TextBlock Text="Delete Draft" VerticalAlignment="Center" Foreground="{StaticResource AppDangerBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelSaleCommand}" IsEnabled="{Binding IsNotBusy}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="17" Margin="0,0,8,0" />
                                            <TextBlock Text="Cancel Sale" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource OutlineButton}" Content="Close" Command="{Binding CancelEditCommand}" Margin="0,0,12,0" MinWidth="96" />
                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Save24}" Content="Save Draft" Height="40" Padding="18,0" Margin="0,0,12,0"
                                               Command="{Binding SaveDraftCommand}" IsEnabled="{Binding IsNotBusy}"
                                               Visibility="{Binding CanEditFields, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ReceiptMoney24}" Content="Create Invoice" Height="40" Padding="18,0"
                                               Command="{Binding InvoiceCommand}" IsEnabled="{Binding IsNotBusy}"
                                               ToolTip="Invoices the sale and issues the items from stock"
                                               Visibility="{Binding CanInvoice, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <controls:ConfirmationDialog DataContext="{Binding Dialog}" />
    </Grid>
</Page>
