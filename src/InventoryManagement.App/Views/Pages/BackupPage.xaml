<Page x:Class="InventoryManagement.App.Views.Pages.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Backup">
    <ScrollViewer x:Name="BackupScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  PanningMode="VerticalOnly">
        <Grid Margin="20" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="Create Backup Now" Command="{Binding CreateBackupCommand}" Appearance="Primary"
                           IsEnabled="{Binding IsNotBusy}" Margin="0,0,12,0" />
                <ui:Button Content="Restore From File..." Command="{Binding RestoreFromFileCommand}"
                           IsEnabled="{Binding IsNotBusy}" />
            </StackPanel>

            <ui:TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,16" />

            <StackPanel Grid.Row="3">
                <ui:TextBlock Text="Backup History" FontTypography="BodyStrong" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding BackupHistory}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="160" />
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="240" />
                        <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeBytes}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
