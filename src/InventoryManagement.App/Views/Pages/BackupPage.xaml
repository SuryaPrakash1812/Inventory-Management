<Page x:Class="InventoryManagement.App.Views.Pages.BackupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Backup">
    <ScrollViewer x:Name="BackupScrollViewer"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" PanningMode="VerticalOnly">
        <StackPanel Margin="20,4,20,24">
            <controls:PageHeader Title="Backup &amp; Restore" Subtitle="Keep encrypted copies of your data and restore them when needed.">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon CloudArrowUp24}" Content="Create Backup Now" Height="40" Padding="16,0"
                               Command="{Binding CreateBackupCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding RestoreFromFileCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="17" Margin="0,0,8,0" />
                            <TextBlock Text="Restore From File..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenBackupFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="17" Margin="0,0,8,0" />
                            <TextBlock Text="Open Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader>

            <!-- Where / when / how -->
            <UniformGrid Columns="3" Margin="0,0,-16,20">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="24" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Backup Folder" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="{Binding BackupFolder}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource KpiGreenSoftBrush}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="ClockArrowDownload24" FontSize="24" Foreground="{StaticResource KpiGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Automatic Backups" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="{Binding ScheduleDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource KpiPurpleSoftBrush}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="24" Foreground="{StaticResource KpiPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Encrypted" FontSize="14" FontWeight="Medium" Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Backups can only be restored by your licensed copy of Inventory Management." Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessMessage}" Margin="4,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="4,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

            <!-- History -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
                        <ui:SymbolIcon Symbol="History24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                        <TextBlock Text="Backup History" Style="{StaticResource CardTitle}" Margin="14,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding BackupHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="1.1*" />
                            <DataGridTemplateColumn Header="Type" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Pill" Style="{StaticResource StatusPill}" Background="{StaticResource KpiBlueSoftBrush}">
                                            <TextBlock x:Name="Label" Text="Manual" FontSize="12.5" Foreground="{StaticResource KpiBlueBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource KpiPurpleSoftBrush}" />
                                                <Setter TargetName="Label" Property="Text" Value="Automatic" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource KpiPurpleBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2.2*" />
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeBytes, StringFormat=N0}" Width="*" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                            <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, TargetNullValue='-'}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Height="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
