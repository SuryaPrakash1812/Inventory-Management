<Page x:Class="InventoryManagement.App.Views.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Categories">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search categories by name"
                        Width="280"
                        Margin="0,0,8,0">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Content="Search" Command="{Binding SearchCommand}" Margin="0,0,16,0" />
            <ui:Button Content="New Category" Command="{Binding StartCreateCommand}" Appearance="Primary" />
            <ui:TextBlock Text="{Binding ErrorMessage}"
                          Foreground="IndianRed"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Categories}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentCategoryName}" Width="140" />
                    <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="80" />
                    <DataGridTemplateColumn Header="" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Edit"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Delete"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ui:Card Grid.Column="1" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ui:TextBlock Text="Category Details" FontTypography="BodyStrong" Margin="0,0,0,12" />

                    <ui:TextBlock Text="Name (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10" />

                    <ui:TextBlock Text="Description (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10" />

                    <ui:TextBlock Text="Parent category (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ParentCategoryOptions}"
                              SelectedItem="{Binding FormParentCategory}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
