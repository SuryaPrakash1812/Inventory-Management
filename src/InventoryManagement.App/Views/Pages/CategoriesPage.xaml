<Page x:Class="InventoryManagement.App.Views.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Categories">
    <Grid>

        <!-- ================= LIST VIEW ================= -->
        <ScrollViewer x:Name="ListScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <controls:PageHeader Title="Categories" Subtitle="Group your products so they are easy to find, filter and report on.">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New Category" Height="40" Padding="16,0"
                               Command="{Binding StartCreateCommand}" />
                </controls:PageHeader>

                <UniformGrid Columns="4" Margin="0,0,-16,20">
                    <controls:StatCard Title="Total Categories" Value="{Binding TotalCategoryCount}" Caption="All categories"
                                       Icon="Tag24" Accent="{StaticResource KpiBlueBrush}" AccentSoft="{StaticResource KpiBlueSoftBrush}" />
                    <controls:StatCard Title="In Use" Value="{Binding UsedCategoryCount}" Caption="Have at least one product"
                                       Icon="BoxCheckmark24" Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}" />
                    <controls:StatCard Title="Empty" Value="{Binding EmptyCategoryCount}" Caption="No products yet"
                                       Icon="Box24" Accent="{StaticResource KpiOrangeBrush}" AccentSoft="{StaticResource KpiOrangeSoftBrush}" />
                    <controls:StatCard Title="Subcategories" Value="{Binding SubcategoryCount}" Caption="Nested under a parent"
                                       Icon="TextBulletListTree24" Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}" />
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="20,20,20,16">
                            <controls:SearchField Text="{Binding SearchTerm}" Placeholder="Search categories by name..." SubmitCommand="{Binding SearchCommand}" />
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  MinHeight="120" controls:RowDoubleClick.Command="{Binding StartEditCommand}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Category" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource KpiBlueSoftBrush}">
                                                    <ui:SymbolIcon Symbol="Tag24" FontSize="16" Foreground="{StaticResource KpiBlueBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Parent" Binding="{Binding ParentCategoryName, TargetNullValue='-'}" Width="1.3*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, TargetNullValue='-'}" Width="2*" />
                                <DataGridTemplateColumn Header="Products" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{StaticResource AppHoverBrush}">
                                                <TextBlock Text="{Binding ProductCount}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:RowActionsButton Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <controls:RowActionsButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.StartEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </controls:RowActionsButton.ContextMenu>
                                            </controls:RowActionsButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="20,14" Style="{StaticResource SecondaryText}" FontSize="14">
                            <Run Text="Showing" /> <Run Text="{Binding Categories.Count, Mode=OneWay}" /> <Run Text="categories" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= EDIT VIEW ================= -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Categories" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Category Details" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Name the category and, optionally, nest it under a parent." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <controls:FormSection Title="Basic Information" Subtitle="How this category appears across the app" Icon="Tag24">
                            <StackPanel>
                                <controls:FormField Label="Category Name" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Steel" />
                                </controls:FormField>
                                <controls:FormField Label="Description" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                TextWrapping="Wrap" Height="88" VerticalContentAlignment="Top" />
                                </controls:FormField>
                            </StackPanel>
                        </controls:FormSection>

                        <controls:FormSection Title="Hierarchy" Subtitle="Make this a subcategory of another category" Icon="TextBulletListTree24"
                                              Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                            <controls:FormField Label="Parent Category" IsOptional="True">
                                <ComboBox ItemsSource="{Binding ParentCategoryOptions}" SelectedItem="{Binding FormParentCategory}" DisplayMemberPath="Name" />
                            </controls:FormField>
                        </controls:FormSection>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="14,4,14,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource OutlineButton}" Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,12,0" MinWidth="96" />
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save Category" Height="40" Padding="18,0"
                                           Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
