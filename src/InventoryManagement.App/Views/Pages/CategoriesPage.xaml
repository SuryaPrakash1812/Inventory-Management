<Page x:Class="InventoryManagement.App.Views.Pages.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Categories">
    <Grid Margin="20">

        <!-- LIST VIEW -->
        <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search categories by name"
                            Width="280"
                            Margin="0,0,8,8">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Content="Search" Command="{Binding SearchCommand}" Margin="0,0,16,8" />
                <ui:Button Content="New Category" Command="{Binding StartCreateCommand}" Appearance="Primary" Margin="0,0,16,8" />
                <ui:TextBlock Text="{Binding ErrorMessage}"
                              Foreground="IndianRed"
                              VerticalAlignment="Center"
                              Margin="0,0,0,8" />
            </WrapPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Categories}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentCategoryName}" Width="180" />
                    <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Edit"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Delete"
                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- EDIT VIEW: full width, its own dedicated screen. -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="800" HorizontalAlignment="Center">
                    <ui:Button Content="&#x2190; Back to Categories"
                               Command="{Binding CancelEditCommand}"
                               Appearance="Transparent"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12" />

                    <ui:Card Padding="28">
                        <StackPanel>
                            <ui:TextBlock Text="Category Details" FontTypography="TitleLarge" Margin="0,0,0,24" />

                            <ui:TextBlock Text="Name (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,16" />

                            <ui:TextBlock Text="Description (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="80"
                                        Margin="0,0,0,16" />

                            <ui:TextBlock Text="Parent category (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ParentCategoryOptions}"
                                      SelectedItem="{Binding FormParentCategory}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,24" />

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
