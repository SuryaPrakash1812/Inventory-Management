<Page x:Class="InventoryManagement.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">
    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  PanningMode="VerticalOnly">
        <Grid Margin="20" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Key metrics: one row, no repeated identical tiles - each card is distinct information -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,12,12">
                    <StackPanel>
                        <ui:TextBlock Text="Products" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding ActiveProductCount}" FontTypography="TitleLarge" />
                        <ui:TextBlock FontTypography="Caption" Opacity="0.6">
                            <Run Text="{Binding TotalProductCount, Mode=OneWay}" /> <Run Text="total" />
                        </ui:TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,12,12">
                    <StackPanel>
                        <ui:TextBlock Text="Inventory Value" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding InventoryValueAtCost, StringFormat=N2}" FontTypography="TitleLarge" />
                        <ui:TextBlock Text="at cost" FontTypography="Caption" Opacity="0.6" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,12,12">
                    <StackPanel>
                        <ui:TextBlock Text="Needs Attention" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding LowStockCount}" FontTypography="TitleLarge" />
                        <ui:TextBlock FontTypography="Caption" Opacity="0.6">
                            <Run Text="low stock," /> <Run Text="{Binding OutOfStockCount, Mode=OneWay}" /> <Run Text="out of stock" />
                        </ui:TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <ui:TextBlock Text="Open Purchases" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding DraftPurchaseCount}" FontTypography="TitleLarge" />
                        <ui:TextBlock FontTypography="Caption" Opacity="0.6">
                            <Run Text="draft," /> <Run Text="{Binding ConfirmedPurchaseCount, Mode=OneWay}" /> <Run Text="confirmed" />
                        </ui:TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,20">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Text="Draft Sales" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding DraftSaleCount}" FontTypography="TitleLarge" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <ui:TextBlock Text="Invoiced Sales" FontTypography="Caption" Opacity="0.6" />
                        <ui:TextBlock Text="{Binding InvoicedSaleCount}" FontTypography="TitleLarge" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent activity: three focused lists, not decorative charts -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <ui:TextBlock Text="Recent Purchases" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentPurchases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <ui:TextBlock Text="{Binding PurchaseNumber}" FontTypography="BodyStrong" />
                                        <ui:TextBlock Opacity="0.7">
                                            <Run Text="{Binding Status, Mode=OneWay}" /> <Run Text="-" /> <Run Text="{Binding TotalAmount, StringFormat=N2, Mode=OneWay}" />
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <ui:TextBlock Text="Recent Sales" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentSales}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <ui:TextBlock Text="{Binding SaleNumber}" FontTypography="BodyStrong" />
                                        <ui:TextBlock Opacity="0.7">
                                            <Run Text="{Binding Status, Mode=OneWay}" /> <Run Text="-" /> <Run Text="{Binding TotalAmount, StringFormat=N2, Mode=OneWay}" />
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <ui:TextBlock Text="Recent Stock Movements" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentStockMovements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <ui:TextBlock Text="{Binding ProductName}" FontTypography="BodyStrong" />
                                        <ui:TextBlock Opacity="0.7">
                                            <Run Text="{Binding MovementType, Mode=OneWay}" /> <Run Text="{Binding QuantityChange, StringFormat=N2, Mode=OneWay}" />
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
