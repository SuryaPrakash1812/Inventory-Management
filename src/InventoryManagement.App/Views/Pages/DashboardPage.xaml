<Page x:Class="InventoryManagement.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Dashboard">

    <Page.Resources>
        <!-- One KPI card: tinted card, coloured icon tile, title, big value, caption, chevron, faint watermark icon -->
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinHeight" Value="132" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="KpiTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="40" />
        </Style>

        <Style x:Key="TableHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppTableHeaderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="36" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  PanningMode="VerticalOnly">
        <Grid Margin="20,4,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Heading + date range ===== -->
            <Grid Grid.Row="0" Margin="4,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                    <TextBlock Text="{Binding WelcomeText}" FontSize="15" Margin="0,6,0,0" Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>

                <Button x:Name="DateRangeButton" Grid.Column="1" Style="{StaticResource FlatButton}" VerticalAlignment="Center"
                        Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                        Padding="14,10" Click="OnDateRangeClick" ToolTip="Period used by the Purchase Trend chart">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="18" Foreground="{StaticResource AppTextSecondaryBrush}" />
                        <TextBlock Text="{Binding RangeText}" FontSize="14" Margin="10,0,16,0" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ChevronDown20" FontSize="14" Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding DateRanges}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- ===== KPI cards ===== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Products -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}" Background="{StaticResource KpiBlueTintBrush}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Cube24" FontSize="110" Opacity="0.07" Foreground="{StaticResource KpiBlueBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-30" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource KpiBlueBrush}">
                                <ui:SymbolIcon Symbol="Cube24" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="Products" Style="{StaticResource KpiTitle}" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{Binding ActiveProductCount}" Style="{StaticResource KpiValue}" />
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="{Binding TotalProductCount, Mode=OneWay}" /><Run Text=" total products" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CardChevronButton}" VerticalAlignment="Top"
                                    Background="{StaticResource KpiBlueSoftBrush}" Foreground="{StaticResource KpiBlueBrush}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Products" ToolTip="Open Products" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Inventory value -->
                <Border Grid.Column="1" Style="{StaticResource KpiCard}" Background="{StaticResource KpiGreenTintBrush}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Database24" FontSize="110" Opacity="0.08" Foreground="{StaticResource KpiGreenBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-30" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource KpiGreenBrush}">
                                <ui:SymbolIcon Symbol="Database24" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="Inventory Value" Style="{StaticResource KpiTitle}" Foreground="{StaticResource KpiGreenBrush}" />
                                <!-- Large amounts shrink to fit the card instead of being cut off -->
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="56">
                                    <TextBlock Text="{Binding InventoryValueAtCost, StringFormat=N2}" Style="{StaticResource KpiValue}" />
                                </Viewbox>
                                <TextBlock Text="at cost" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CardChevronButton}" VerticalAlignment="Top"
                                    Background="{StaticResource KpiGreenSoftBrush}" Foreground="{StaticResource KpiGreenBrush}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Reports" ToolTip="Open Reports" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Needs attention -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}" Background="{StaticResource KpiOrangeTintBrush}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Warning24" FontSize="110" Opacity="0.08" Foreground="{StaticResource KpiOrangeBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-30" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource KpiOrangeBrush}">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="Needs Attention" Style="{StaticResource KpiTitle}" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{Binding NeedsAttentionCount}" Style="{StaticResource KpiValue}" />
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="{Binding LowStockCount, Mode=OneWay}" /><Run Text=" low stock, " /><Run Text="{Binding OutOfStockCount, Mode=OneWay}" /><Run Text=" out of stock" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CardChevronButton}" VerticalAlignment="Top"
                                    Background="{StaticResource KpiOrangeSoftBrush}" Foreground="{StaticResource KpiOrangeBrush}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Inventory" ToolTip="Open Inventory" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Open purchases -->
                <Border Grid.Column="3" Style="{StaticResource KpiCard}" Background="{StaticResource KpiPurpleTintBrush}" Margin="0">
                    <Grid>
                        <ui:SymbolIcon Symbol="Cart24" FontSize="110" Opacity="0.08" Foreground="{StaticResource KpiPurpleBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-30" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="#A855F7">
                                <ui:SymbolIcon Symbol="Cart24" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="Open Purchases" Style="{StaticResource KpiTitle}" Foreground="{StaticResource KpiPurpleBrush}" />
                                <TextBlock Text="{Binding OpenPurchaseCount}" Style="{StaticResource KpiValue}" />
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="{Binding DraftPurchaseCount, Mode=OneWay}" /><Run Text=" draft, " /><Run Text="{Binding AwaitingPaymentCount, Mode=OneWay}" /><Run Text=" unpaid" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CardChevronButton}" VerticalAlignment="Top"
                                    Background="{StaticResource KpiPurpleSoftBrush}" Foreground="{StaticResource KpiPurpleBrush}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Purchases" ToolTip="Open Purchases" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Charts ===== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.85*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Purchase trend -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Cart24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                <TextBlock Text="Purchase Trend" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Run Text="Total" /> <Run Text="{Binding PurchaseTrendTotal, StringFormat=N2, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Style="{StaticResource CardDropdown}"
                                      ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" />
                        </Grid>
                        <controls:LineChart Grid.Row="1" Points="{Binding PurchaseTrend}" />
                    </Grid>
                </Border>

                <!-- Stock insights -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Stock Insights" Style="{StaticResource CardTitle}" Margin="14,0,0,0" />
                            <ComboBox Grid.Column="2" Style="{StaticResource CardDropdown}"
                                      ItemsSource="{Binding InsightModes}" SelectedItem="{Binding SelectedInsightMode}" />
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="150" Height="150" Margin="0,0,20,0">
                                <controls:DonutChart Segments="{Binding InsightSegments}" Thickness="24" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InsightTotal}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding InsightCenterLabel}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding InsightSegments}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="13" Height="13" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" Margin="12,0,8,0"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="14" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="14" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Recent activity ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <!-- Recent purchases -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0" Padding="16,16,16,10">
                    <!-- Status/Amount/Date size to their content (shared by header and rows); PO Number takes the rest -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <Grid Margin="4,0,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Cart24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Recent Purchases" Style="{StaticResource CardTitle}" Margin="14,0,0,0" />
                            <Button Grid.Column="2" Content="View All" Style="{StaticResource LinkButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Purchases" />
                        </Grid>
                        <Border Style="{StaticResource TableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseStatus" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseAmount" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseDate" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PO Number" Style="{StaticResource TableHeaderText}" />
                                <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TableHeaderText}" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="2" Text="Amount" Style="{StaticResource TableHeaderText}" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="3" Text="Date" Style="{StaticResource TableHeaderText}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding RecentPurchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseStatus" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseAmount" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PurchaseDate" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PurchaseNumber}" Style="{StaticResource TableCellText}" Margin="0,0,10,0"
                                                       ToolTip="{Binding PurchaseNumber}" />
                                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" Margin="0,0,14,0"
                                                    Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat=N2}" Style="{StaticResource TableCellText}" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding PurchaseDate, StringFormat=MMM d\, yyyy}" Style="{StaticResource TableCellText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No purchases yet." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="{Binding HasRecentPurchases, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Recent sales -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,20,0" Padding="16,16,16,10">
                    <StackPanel>
                        <Grid Margin="4,0,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Recent Sales" Style="{StaticResource CardTitle}" Margin="14,0,0,0" />
                            <Button Grid.Column="2" Content="View All" Style="{StaticResource LinkButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Sales" />
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,10"
                                    Visibility="{Binding HasRecentSales, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="56" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No recent sales" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,10,0,6"
                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Sales records will appear here once you start making sales." Style="{StaticResource SecondaryText}"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="230" />
                            <ui:Button Content="Create Sale" Appearance="Primary" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="22,8"
                                       Command="{Binding NavigateCommand}" CommandParameter="CreateSale" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasRecentSales, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource TableHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sale #" Style="{StaticResource TableHeaderText}" />
                                    <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource TableHeaderText}" />
                                    <TextBlock Grid.Column="2" Text="Amount" Style="{StaticResource TableHeaderText}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SaleNumber}" Style="{StaticResource TableCellText}" Margin="0,0,8,0"
                                                           ToolTip="{Binding CustomerName}" />
                                                <Border Grid.Column="1" Style="{StaticResource StatusPill}"
                                                        Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat=N2}" Style="{StaticResource TableCellText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent stock movements -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,16,16,10">
                    <StackPanel>
                        <Grid Margin="4,0,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="24" Foreground="{StaticResource AppPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="Recent Stock Movements" Style="{StaticResource CardTitle}" Margin="14,0,0,0" />
                            <Button Grid.Column="2" Content="View All" Style="{StaticResource LinkButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Inventory" />
                        </Grid>
                        <Border Style="{StaticResource TableHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Product" Style="{StaticResource TableHeaderText}" />
                                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource TableHeaderText}" />
                                <TextBlock Grid.Column="2" Text="Quantity" Style="{StaticResource TableHeaderText}" />
                                <TextBlock Grid.Column="3" Text="Date" Style="{StaticResource TableHeaderText}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding RecentStockMovements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProductName}" Style="{StaticResource TableCellText}" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Style="{StaticResource StatusPill}"
                                                    Background="{Binding MovementType, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding MovementType, Converter={StaticResource EnumDisplay}}" FontSize="12.5"
                                                           Foreground="{Binding MovementType, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding QuantityChange, StringFormat=N2}" Style="{StaticResource TableCellText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding OccurredAtUtc, StringFormat=MMM d\, yyyy}" Style="{StaticResource TableCellText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No stock movements yet." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="{Binding HasRecentMovements, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
