<Page x:Class="InventoryManagement.App.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Reports">
    <ScrollViewer x:Name="ReportsScrollViewer"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent" PanningMode="VerticalOnly">
        <StackPanel Margin="20,4,20,24">
            <controls:PageHeader Title="Reports" Subtitle="Stock, purchase and sales reports - view them here or export them to Excel.">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowExportLtr24}" Content="Export to CSV" Height="40" Padding="16,0"
                           Command="{Binding ExportCommand}" />
            </controls:PageHeader>

            <!-- Report picker + period -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Report" Style="{StaticResource FilterLabel}" Margin="0,0,10,8" />
                        <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}"
                                  MinWidth="200" Margin="0,0,24,8" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsDateRangeFilter, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="From" Style="{StaticResource FilterLabel}" Margin="0,0,10,8" />
                            <DatePicker SelectedDate="{Binding FromDate}" Width="160" Margin="0,0,16,8" VerticalAlignment="Center" />
                            <TextBlock Text="To" Style="{StaticResource FilterLabel}" Margin="0,0,10,8" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="160" Margin="0,0,16,8" VerticalAlignment="Center" />
                            <Button Style="{StaticResource OutlineButton}" Content="Apply" Command="{Binding RunReportCommand}" Margin="0,0,0,8" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SuccessMessage}" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Report -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="22,20,22,16">
                        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource KpiBlueSoftBrush}">
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="22" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedReportType, StringFormat='{}{0} Report'}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding InventoryReport}" Visibility="{Binding IsShowingInventory, Converter={StaticResource BoolToVisibility}}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.2*" />
                                <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat=0.##}" Width="*" />
                                <DataGridTextColumn Header="Cost Price" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="*" />
                                <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding LowStockReport}" Visibility="{Binding IsShowingLowStock, Converter={StaticResource BoolToVisibility}}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat=0.##}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Minimum Stock" Binding="{Binding MinimumStock, StringFormat=0.##}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding PurchaseReport}" Visibility="{Binding IsShowingPurchases, Converter={StaticResource BoolToVisibility}}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Purchase #" Binding="{Binding PurchaseNumber}" Width="1.3*" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.6*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=MMM d\, yyyy}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*" FontWeight="SemiBold" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding SaleReport}" Visibility="{Binding IsShowingSales, Converter={StaticResource BoolToVisibility}}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sale #" Binding="{Binding SaleNumber}" Width="1.3*" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.6*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=MMM d\, yyyy}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding Status, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12.5"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="*" FontWeight="SemiBold" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding StockMovementReport}" Visibility="{Binding IsShowingStockMovements, Converter={StaticResource BoolToVisibility}}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding OccurredAtUtc, StringFormat=g}" Width="1.2*" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.6*" />
                                <DataGridTemplateColumn Header="Movement" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Background="{Binding MovementType, Converter={StaticResource StatusPillBrush}}">
                                                <TextBlock Text="{Binding MovementType, Converter={StaticResource EnumDisplay}}" FontSize="12.5"
                                                           Foreground="{Binding MovementType, Converter={StaticResource StatusPillBrush}, ConverterParameter=Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityChange, StringFormat=+0.##;-0.##;0}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceType, Converter={StaticResource EnumDisplay}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Height="12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
