<Page x:Class="InventoryManagement.App.Views.Pages.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Purchases">
    <Grid Margin="20">

        <!-- LIST VIEW -->
        <Grid Visibility="{Binding IsShowingList, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="New Purchase" Command="{Binding StartCreateCommand}" Appearance="Primary" />
            </WrapPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search by purchase # or supplier invoice #"
                            Width="260"
                            Margin="0,0,16,8">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:TextBlock Text="Supplier:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplierFilter}"
                          DisplayMemberPath="Name"
                          MinWidth="160"
                          Margin="0,0,16,8" />

                <ui:TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          MinWidth="110"
                          Margin="0,0,16,8" />

                <ui:TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <DatePicker SelectedDate="{Binding FromDateFilter}" Margin="0,0,16,8" />

                <ui:TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <DatePicker SelectedDate="{Binding ToDateFilter}" Margin="0,0,16,8" />

                <ui:Button Content="Search" Command="{Binding SearchCommand}" Appearance="Primary" Margin="0,0,8,8" />
                <ui:Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,8" />
            </WrapPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Purchases}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Purchase #" Binding="{Binding PurchaseNumber}" Width="110" />
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="180" />
                    <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="110" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Open"
                                           Command="{Binding DataContext.StartViewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                    <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="total)" />
                </ui:TextBlock>
                <ui:Button Content="Next" Command="{Binding NextPageCommand}" />
            </WrapPanel>
        </Grid>

        <!-- DETAIL VIEW -->
        <ScrollViewer x:Name="DetailScrollViewer"
                      Visibility="{Binding IsViewingDetail, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
                    <ui:Button Content="&#x2190; Back to Purchases"
                               Command="{Binding CancelEditCommand}"
                               Appearance="Transparent"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12" />

                    <ui:Card Padding="28">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <ui:TextBlock Text="{Binding PurchaseNumberDisplay}" FontTypography="TitleLarge" Margin="0,0,16,0" />
                                <ui:TextBlock Text="{Binding CurrentStatus}" FontTypography="BodyStrong" VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>

                            <!-- Header fields -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Supplier (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Suppliers}"
                                              SelectedItem="{Binding FormSupplier}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEditFields}"
                                              Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Supplier invoice # (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormSupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding CanEditFields}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <ui:TextBlock Text="Purchase date" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding FormPurchaseDate}"
                                                IsEnabled="{Binding CanEditFields}"
                                                Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsNewPurchase, Converter={StaticResource InverseBoolToVisibility}}"
                                        Margin="0,0,0,16">
                                <ui:TextBlock Text="Payment status" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PaymentStatusOptions}"
                                          SelectedItem="{Binding FormPaymentStatus}"
                                          MaxWidth="220"
                                          HorizontalAlignment="Left" />
                            </StackPanel>

                            <ui:TextBlock Text="Notes (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanEditFields}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="60"
                                        Margin="0,0,0,20" />

                            <!-- Line item entry -->
                            <StackPanel Visibility="{Binding CanEditFields, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,12">
                                <ui:TextBlock Text="Add item - scan or type SKU/barcode/name, then press Enter" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="ProductSearchBox"
                                            Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="SKU, barcode, or product name"
                                            MaxWidth="400"
                                            HorizontalAlignment="Left">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddLineItemCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="{Binding IsReadOnlyLineItems}"
                                      MaxHeight="320"
                                      Margin="0,0,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="Tax %" Binding="{Binding TaxPercentage, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="Remove"
                                                           Visibility="{Binding DataContext.CanEditFields, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"
                                                           Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Totals -->
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:TextBlock Text="Subtotal: " Opacity="0.7" />
                                    <ui:TextBlock Text="{Binding FormSubtotal, StringFormat=N2}" FontTypography="BodyStrong" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:TextBlock Text="Discount: " Opacity="0.7" />
                                    <ui:TextBlock Text="{Binding FormDiscountTotal, StringFormat=N2}" FontTypography="BodyStrong" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:TextBlock Text="Tax: " Opacity="0.7" />
                                    <ui:TextBlock Text="{Binding FormTaxTotal, StringFormat=N2}" FontTypography="BodyStrong" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:TextBlock Text="Total: " FontTypography="BodyStrong" />
                                    <ui:TextBlock Text="{Binding FormTotal, StringFormat=N2}" FontTypography="TitleLarge" />
                                </StackPanel>
                            </StackPanel>

                            <ui:TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ui:TextBlock Text="{Binding StatusMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Save Draft"
                                           Command="{Binding SaveDraftCommand}"
                                           Appearance="Primary"
                                           Visibility="{Binding CanEditFields, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,0,8,0" />
                                <ui:Button Content="Confirm (updates stock)"
                                           Command="{Binding ConfirmCommand}"
                                           Appearance="Primary"
                                           Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,0,8,0" />
                                <ui:Button Content="Cancel Purchase"
                                           Command="{Binding CancelPurchaseCommand}"
                                           Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,0,8,0" />
                                <ui:Button Content="Delete Draft"
                                           Command="{Binding DeleteDraftCommand}"
                                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,0,8,0" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
