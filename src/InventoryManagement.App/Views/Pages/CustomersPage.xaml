<Page x:Class="InventoryManagement.App.Views.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:InventoryManagement.App.Controls"
      Title="Customers">
    <Grid>

        <!-- ================= LIST VIEW ================= -->
        <ScrollViewer x:Name="ListScrollViewer"
                      Visibility="{Binding IsShowingList, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <controls:PageHeader Title="Customers" Subtitle="Manage the people and businesses you sell to.">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New Customer" Height="40" Padding="16,0"
                               Command="{Binding StartCreateCommand}" />
                </controls:PageHeader>

                <UniformGrid Columns="4" Margin="0,0,-16,20">
                    <controls:StatCard Title="Total Customers" Value="{Binding AllCustomerCount}" Caption="All customers on record"
                                       Icon="PeopleTeam24" Accent="{StaticResource KpiBlueBrush}" AccentSoft="{StaticResource KpiBlueSoftBrush}" />
                    <controls:StatCard Title="Active" Value="{Binding ActiveCustomerCount}" Badge="{Binding ActivePercent}" Caption="Available for new sales"
                                       Icon="CheckmarkCircle24" Accent="{StaticResource KpiGreenBrush}" AccentSoft="{StaticResource KpiGreenSoftBrush}" />
                    <controls:StatCard Title="Inactive" Value="{Binding InactiveCustomerCount}" Caption="Hidden from new sales"
                                       Icon="DismissCircle24" Accent="#64748B" AccentSoft="#F1F5F9" />
                    <controls:StatCard Title="Missing Contact" Value="{Binding MissingContactCount}" Caption="No phone or email"
                                       Icon="Warning24" Accent="{StaticResource KpiOrangeBrush}" AccentSoft="{StaticResource KpiOrangeSoftBrush}" />
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="20,20,20,16">
                            <controls:SearchField Text="{Binding SearchTerm}" Placeholder="Search by name, phone, or email..."
                                                  SubmitCommand="{Binding SearchCommand}" Margin="0,0,0,14" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Status" Style="{StaticResource FilterLabel}" />
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding ActiveFilterOptions}" SelectedItem="{Binding SelectedActiveFilter}" />
                                <TextBlock Text="Name" Style="{StaticResource FilterLabel}" />
                                <ToggleButton Style="{StaticResource OutlineIconButton}" IsChecked="{Binding SortDescending}"
                                              ToolTip="Sort A-Z / Z-A" Margin="0,0,20,0">
                                    <ui:SymbolIcon Symbol="ArrowSort24" FontSize="18" />
                                </ToggleButton>
                                <Button Style="{StaticResource OutlineButton}" Content="Clear Filters" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="0,12,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" MinHeight="120" controls:RowDoubleClick.Command="{Binding StartEditCommand}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Customer" Width="2*" CellTemplate="{StaticResource NameWithAvatar}" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone, TargetNullValue='-'}" Width="1.2*" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email, TargetNullValue='-'}" Width="1.8*" />
                                <DataGridTextColumn Header="Tax ID" Binding="{Binding TaxId, TargetNullValue='-'}" Width="*" />
                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ActivePill}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:RowActionsButton Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <controls:RowActionsButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.StartEditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="View history" Command="{Binding PlacementTarget.Tag.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="History24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Deactivate" Command="{Binding PlacementTarget.Tag.DeactivateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Prohibited24" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </controls:RowActionsButton.ContextMenu>
                                            </controls:RowActionsButton>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0">
                            <controls:Pager ItemName="customers" PageNumber="{Binding PageNumber}" TotalPages="{Binding TotalPages}"
                                            TotalCount="{Binding TotalCount}" PageSize="{Binding PageSize}"
                                            PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= EDIT VIEW ================= -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelEditCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Customers" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Card}" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="Person24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Customer Details" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Add or edit the customer's contact, address and tax details." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <controls:FormSection Title="Contact Details" Subtitle="Who the customer is and how to reach them" Icon="Person24">
                            <StackPanel>
                                <controls:FormField Label="Customer Name" IsRequired="True">
                                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:FormField Label="Phone" IsOptional="True">
                                        <ui:TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </controls:FormField>
                                    <controls:FormField Grid.Column="2" Label="Email" IsOptional="True">
                                        <ui:TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" />
                                    </controls:FormField>
                                </Grid>
                                <controls:FormField Label="Address" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                Height="72" VerticalContentAlignment="Top" />
                                </controls:FormField>
                            </StackPanel>
                        </controls:FormSection>

                        <controls:FormSection Title="Tax &amp; Notes" Subtitle="GST / VAT registration and anything else to remember" Icon="DocumentText24"
                                              Accent="{StaticResource KpiPurpleBrush}" AccentSoft="{StaticResource KpiPurpleSoftBrush}">
                            <StackPanel>
                                <controls:FormField Label="GST / VAT / Tax ID" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormTaxId, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:FormField>
                                <controls:FormField Label="Notes" IsOptional="True">
                                    <ui:TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                                Height="72" VerticalContentAlignment="Top" />
                                </controls:FormField>
                                <CheckBox Content="Active (available for new sales)" IsChecked="{Binding FormIsActive}" Margin="0,0,0,8"
                                          Visibility="{Binding IsNewCustomer, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </controls:FormSection>

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorMessage}" Margin="14,4,14,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                        <Border BorderBrush="{StaticResource AppDividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource OutlineButton}" Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,12,0" MinWidth="96" />
                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save Customer" Height="40" Padding="18,0"
                                           Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= HISTORY VIEW ================= -->
        <ScrollViewer x:Name="HistoryScrollViewer"
                      Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" PanningMode="VerticalOnly">
            <StackPanel Margin="20,4,20,24">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CloseHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="17" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Customers" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource Card}" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource KpiBlueSoftBrush}">
                                <ui:SymbolIcon Symbol="History24" FontSize="26" Foreground="{StaticResource KpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryCustomerName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Every change made to this customer, newest first." Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding HistoryEntries}" ItemTemplate="{StaticResource HistoryEntry}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
