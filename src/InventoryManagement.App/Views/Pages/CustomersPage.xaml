<Page x:Class="InventoryManagement.App.Views.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Customers">
    <Grid Margin="20">

        <!-- LIST VIEW -->
        <Grid Visibility="{Binding IsShowingList, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:Button Content="New Customer" Command="{Binding StartCreateCommand}" Appearance="Primary" />
            </WrapPanel>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search by name, phone, or email"
                            Width="280"
                            Margin="0,0,16,8">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <ui:TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding ActiveFilterOptions}"
                          SelectedItem="{Binding SelectedActiveFilter}"
                          MinWidth="120"
                          Margin="0,0,16,8" />

                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" Margin="0,0,16,8" />

                <ui:Button Content="Search" Command="{Binding SearchCommand}" Appearance="Primary" Margin="0,0,8,8" />
                <ui:Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,16,8" />
                <ui:TextBlock Text="Filters apply when you click Search"
                              FontTypography="Caption"
                              Opacity="0.6"
                              VerticalAlignment="Center"
                              Margin="0,0,0,8" />
            </WrapPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Customers}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                    <DataGridTextColumn Header="Tax ID" Binding="{Binding TaxId}" Width="120" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                    <DataGridTemplateColumn Header="" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Edit"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="History"
                                               Margin="0,0,4,0"
                                               Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Deactivate"
                                               Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="Page" /> <Run Text="{Binding PageNumber, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding TotalPages, Mode=OneWay}" />
                    <Run Text="(" /><Run Text="{Binding TotalCount, Mode=OneWay}" /> <Run Text="total)" />
                </ui:TextBlock>
                <ui:Button Content="Next" Command="{Binding NextPageCommand}" />
            </WrapPanel>
        </Grid>

        <!-- EDIT VIEW -->
        <ScrollViewer x:Name="EditScrollViewer"
                      Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      PanningMode="VerticalOnly">
            <Grid Background="Transparent">
                <StackPanel MaxWidth="900" HorizontalAlignment="Center">
                    <ui:Button Content="&#x2190; Back to Customers"
                               Command="{Binding CancelEditCommand}"
                               Appearance="Transparent"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,12" />

                    <ui:Card Padding="28">
                        <StackPanel>
                            <ui:TextBlock Text="Customer Details" FontTypography="TitleLarge" Margin="0,0,0,24" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Name (required)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="Phone (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="Email (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock Text="GST/VAT/Tax ID (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                    <ui:TextBox Text="{Binding FormTaxId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                </StackPanel>
                            </Grid>

                            <ui:TextBlock Text="Address (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="60"
                                        Margin="0,0,0,16" />

                            <StackPanel Visibility="{Binding IsNewCustomer, Converter={StaticResource InverseBoolToVisibility}}"
                                        Margin="0,0,0,16">
                                <ui:TextBlock Text="Active" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                                <CheckBox Content="Active" IsChecked="{Binding FormIsActive}" />
                            </StackPanel>

                            <ui:TextBlock Text="Notes (optional)" FontTypography="Caption" Opacity="0.6" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="60"
                                        Margin="0,0,0,16" />

                            <ui:TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- HISTORY VIEW -->
        <Grid Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Button Grid.Row="0"
                       Content="&#x2190; Back to Customers"
                       Command="{Binding CloseHistoryCommand}"
                       Appearance="Transparent"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,12" />

            <ui:TextBlock Grid.Row="1"
                          FontTypography="TitleLarge"
                          Margin="0,0,0,16">
                <Run Text="History:" /> <Run Text="{Binding HistoryCustomerName, Mode=OneWay}" />
            </ui:TextBlock>

            <ListView Grid.Row="2" ItemsSource="{Binding HistoryEntries}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="LightGray" Padding="0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{Binding Action}" FontTypography="BodyStrong" Margin="0,0,8,0" />
                                    <ui:TextBlock Text="{Binding OccurredAtUtc, StringFormat='{}{0:g}'}" FontTypography="Caption" Opacity="0.6" />
                                </StackPanel>
                                <ui:TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
