# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
out/
/installer/publish/
/installer/output/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code
.vscode/

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Local application data that must never be committed
*.db
*.db-shm
*.db-wal
appsettings.*.local.json
*.pfx

# Vendor license-signing keys and issued licenses - anyone holding the key
# file can issue licenses, so it must never be committed.
/keys/
vendor-keys*.json
*.lic

# Logs and backups produced at runtime
/logs/
/Backups/

# OS files
.DS_Store
Thumbs.db
